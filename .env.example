# ---- Database (Postgres) ----
# Local: install Postgres and create a db, or use Neon/Supabase free tier.
DATABASE_URL=postgresql://user:password@localhost:5432/ai_saas

# ---- Better Auth ----
# Generate a secret:  openssl rand -base64 32
BETTER_AUTH_SECRET=replace_me_with_a_random_32_char_secret
BETTER_AUTH_URL=http://localhost:3000

# ---- AI providers (set at least one) ----
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# ---- Stripe ----
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# The price ID of your "Pro" subscription product in Stripe
STRIPE_PRO_PRICE_ID=price_...

# ---- App ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
